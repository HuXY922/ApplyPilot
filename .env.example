# No real secrets belong in this file. Configure values on the server.
APPLYPILOT_DATA_DIR=/data
APPLYPILOT_PUBLIC=1
PUBLIC_ORIGIN=https://your-demo-domain.example
PORT=8787
APPLYPILOT_MAX_SESSIONS=32
APPLYPILOT_SESSION_TTL=86400
APPLYPILOT_NEW_SESSIONS_PER_MINUTE=12
APPLYPILOT_SOURCES=bytedance,cxmt
# Fixed reviewed China providers only; 6 requests / 45 seconds shared fairly; each source <=30 seconds.
# Per-request hard limit: CXMT 12 seconds, ByteDance 7, optional Ashby 12; no retries.
# CXMT supports up to 2 pages of 10 jobs, depending on the shared budget.
# Optional, explicitly configured global official boards:
# APPLYPILOT_SOURCES=bytedance,ashby
# APPLYPILOT_ASHBY_BOARDS=Ashby
# Selected deployment provider. The key is configured securely on the server only.
APPLYPILOT_MODEL_PROVIDER=deepseek
APPLYPILOT_DEEPSEEK_MODEL=deepseek-flash
# APPLYPILOT_DEEPSEEK_API_KEY=
# No DeepSeek key means visibly labeled rules mode; no OpenAI/generic key fallback.
# Optional OpenAI compatibility: replace the provider above with openai and set both:
# APPLYPILOT_OPENAI_MODEL=
# APPLYPILOT_OPENAI_API_KEY=
# Claude is not supported. Configuration is not live authenticated verification.
APPLYPILOT_MODEL_CALLS_PER_DAY=20
APPLYPILOT_SESSION_MODEL_CALLS_PER_DAY=5
APPLYPILOT_SEARCHES_PER_HOUR=60
APPLYPILOT_SESSION_SEARCHES_PER_HOUR=10
