FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN useradd --system --uid 10001 radar
COPY radar_worker ./radar_worker
COPY radar_gate.py radar_privacy.py radar_policy.py radar_policy.json ./
USER radar
CMD ["python", "-m", "radar_worker.run", "--report", "/tmp/radar-run.json"]
